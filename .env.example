# ============================================================
#  CAMP DALTO — ENVIRONMENT VARIABLES
#  Copy this file to .env.local for local dev.
#  Set these in Vercel → Project Settings → Environment Variables
#  for production.
# ============================================================

# Shared password everyone in the party uses to view the site.
# Change "freebird" to something fun and memorable.
SITE_PASSWORD=freebird

# Commissioner-only password to update the scoreboard.
# Make it different from SITE_PASSWORD.
ADMIN_PASSWORD=commissioner

# --------------- LIVE SCOREBOARD (KV) -------------------
# Add a Vercel KV store to your project in the Vercel dashboard
# (Storage → Create → KV). Vercel will inject these automatically.
# Without them, the scoreboard works but resets on every deploy
# and won't sync across serverless instances.
#
# KV_REST_API_URL=https://your-kv-id.kv.vercel-storage.com
# KV_REST_API_TOKEN=your-token-here
# KV_REST_API_READ_ONLY_TOKEN=your-read-only-token-here
