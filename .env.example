# ============================================================
#  CAMP DALTO — ENVIRONMENT VARIABLES
#  Copy this file to .env.local for local dev.
#  Set these in Vercel → Project Settings → Environment Variables
#  for production.
# ============================================================

# Shared password everyone in the party uses to view the site.
# Change "freebird" to something fun and memorable.
SITE_PASSWORD=freebird

# Commissioner-only password to update the scoreboard.
# Make it different from SITE_PASSWORD.
ADMIN_PASSWORD=commissioner

# --------------- LIVE SCOREBOARD (Vercel Blob) ----------
# Add a Vercel Blob store to your project (Storage → Create → Blob).
# Vercel injects BLOB_READ_WRITE_TOKEN automatically on the server.
# Without it, the scoreboard falls back to in-memory storage that
# resets on every cold start — fine for dev, not for the party.
#
# BLOB_STORE_ID=store_xxxxxxxxx
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxx

# --------------- ROSTER REVEAL GATE ---------------------
# Set to "true" to blur participant names on the Teams section
# (pre-draft state). Flip to "false" (or unset) once the rosters
# are public. Read at server-render time; flip then redeploy.
# PARTICIPANTS_BLURRED=true

# --------------- CIG CHALLENGE FEATURE FLAG -------------
# Set to "true" to enable the Cig Challenge section on the public
# site and the matching scoring panel in the admin dashboard.
# Each tribe receives one pack at Friday's opening ceremony;
# every cig left in the pack at closing ceremony costs the tribe
# 10 points. Counts are entered in /admin and the penalty is
# applied to team totals automatically.
# CIG_CHALLENGE_ENABLED=true
